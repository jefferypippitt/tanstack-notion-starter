# You don't need to edit this file. `pnpm setup:notion` copies it to .env,
# asks for both values, and replaces the page ID with the database it creates.
#
# To fill it in by hand instead:
# 1. Create an integration at https://www.notion.so/my-integrations and copy its secret
# 2. Create an empty Notion page, then ••• → Connections → add your integration
# 3. Paste the page ID below (the 32 characters at the end of the page URL)
# 4. Run `pnpm setup:notion --seed` to create the database and add demo content

NOTION_API_KEY=ntn_your_notion_integration_secret_here
NOTION_DATABASE_ID=your_page_id_here

# Optional, instead of NOTION_DATABASE_ID: separate databases
# NOTION_POSTS_DATABASE_ID=
# NOTION_PROJECTS_DATABASE_ID=
# NOTION_PROFILE_DATABASE_ID=   # Link / Experience / About rows

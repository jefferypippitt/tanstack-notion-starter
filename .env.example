# Notion Integration Setup
# 1. Create a new integration at https://www.notion.so/my-integrations
# 2. Copy the Internal Integration Token
# 3. Share your database(s) with the integration

NOTION_API_KEY=secret_your_notion_integration_token_here

# Option 1: Single database with a "Type" property (Post | Project)
NOTION_DATABASE_ID=your_database_id_here

# Option 2: Separate databases (comment out NOTION_DATABASE_ID above if using this approach)
# NOTION_POSTS_DATABASE_ID=your_posts_database_id_here
# NOTION_PROJECTS_DATABASE_ID=your_projects_database_id_here

# Optional: About page ID (if you want to manage About content in Notion)
# NOTION_ABOUT_PAGE_ID=your_about_page_id_here
